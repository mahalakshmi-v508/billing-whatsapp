# API base URL of the Laravel backend (must end with /api)
VITE_API_URL=http://localhost:8000/api/

# Image/document root of the Laravel backend (no /api suffix)
# Defaults to VITE_API_URL with "/api/" stripped when left empty
# VITE_API_URL_IMAGE=http://localhost:8000

# Laravel Reverb (WebSockets) — used by real-time features
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080

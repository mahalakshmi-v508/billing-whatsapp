# ===== Environments / secrets (NEVER commit) =====
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ===== Dependencies =====
node_modules/
vendor/

# ===== Laravel storage (logs / cache / sessions / views) =====
billing_software_backend/storage/logs/
billing_software_backend/storage/framework/cache/
billing_software_backend/storage/framework/sessions/
billing_software_backend/storage/framework/views/
billing_software_backend/bootstrap/cache/*
!billing_software_backend/bootstrap/cache/.gitignore


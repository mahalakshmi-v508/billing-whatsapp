# Server
PORT=3001

# Laravel backend URL the service calls back into
LARAVEL_API_URL=http://localhost:8000
# Optional legacy alias (also supported by config.js)
# LARAVEL_URL=http://localhost:8000

# Shared internal token — must match WHATSAPP_INTERNAL_TOKEN in the Laravel .env
LARAVEL_API_KEY=
# Optional legacy alias
# WHATSAPP_INTERNAL_TOKEN=

# Baileys session storage — keep on a persistent volume in production.
# NEVER commit this directory to Git.
SESSION_PATH=./sessions

# Logging level for Baileys (silent | error | warn | info | debug)
BAILEYS_LOG_LEVEL=silent

# Optional: explicit Chromium path for QR preview rendering.
# Leave empty to use auto-detection.
# CHROME_PATH=
